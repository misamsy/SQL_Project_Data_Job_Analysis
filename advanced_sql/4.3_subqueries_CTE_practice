/*
Easy:
Identify the top 5 skills that are most frequently mentioned in job postings. Use a subquery to
find the skill IDs with the highest counts in the skills_job_dim table and then join this result
with the skills_dim table to get the skill names.
*/

WITH skills_job_count AS(
    SELECT 
        skill_id,
        COUNT(*) skill_count
    FROM
        skills_job_dim
    GROUP BY
        skill_id
)
SELECT 
    skills_dim.skills,
    skills_job_count.skill_count
FROM 
    skills_dim
LEFT JOIN skills_job_count ON skills_dim.skill_id = skills_job_count.skill_id
ORDER BY skills_job_count.skill_count DESC

/*
Medium:
Determine the size category ('Small', ‘Medium’, or 'Large') for each company by first identifying
the number of job postings they have. Use a subquery to calculate the total job postings per
company. A company is considered 'Small' if it has less than 10 job postings, 'Medium' if the
number of job postings is between 10 and 50, and 'Large' if it has more than 50 job postings.
Implement a subquery to aggregate job counts per company before classifying them based on
size.
*/

SELECT 
    name,
    subquery_one.total_job_postings,
    CASE
        WHEN subquery_one.total_job_postings < 10 THEN 'Small'
        WHEN subquery_one.total_job_postings BETWEEN 10 AND 50 THEN 'Medium'
        ELSE 'Large'
    END AS size_category,
    COUNT(UNIQUE(size))
FROM company_dim
LEFT JOIN(
    SELECT 
        company_id,
        count (*) total_job_postings
    FROM 
        job_postings_fact
    GROUP BY
        company_id
) AS subquery_one
    ON company_dim.company_id = subquery_one.company_id
ORDER BY
    subquery_one.total_job_postings DESC

SELECT *
FROM job_postings_fact
LIMIT 1000