
--Example of a SubQuery and CTE (Common Table Expression) to filter job postings for the month of January
SELECT *
FROM ( 
    SELECT *
    FROM job_postings_fact
    WHERE EXTRACT(MONTH FROM job_posted_date) = 1
) AS january_jobs;


--example of a CTE (Common Table Expression) to filter job postings for the month of January
WITH january_jobs AS (
    SELECT *
    FROM job_postings_fact
    WHERE EXTRACT(MONTH FROM job_posted_date) = 1
) 

SELECT *
FROM january_jobs;


-- main example of a subquery to filter companies that have job postings that mention no degree requirement
SELECT 
    company_id,
    name AS company_name
FROM 
    company_dim
WHERE company_id IN(
    SELECT
        company_id
    FROM
        job_postings_fact
    WHERE
        job_no_degree_mention = TRUE
    ORDER BY
        company_id
)
-- Everything must be run separately, copying and the part you want and executing it, using ctrl + E twice.